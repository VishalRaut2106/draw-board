  "stickyNotes": [
    {
      "id": "note_e2ee",
      "type": "rectangle",
      "label": "🔒 STICKY NOTE: E2EE & Signal Protocol\n• Clients encrypt messages locally before transmission\n• Uses Signal Protocol (Double Ratchet Algorithm)\n• WhatsApp servers only route raw ciphertext bytes\n• Private keys NEVER leave User devices\n• Servers cannot read message content!",
      "x": 1400,
      "y": 105,
      "width": 380,
      "height": 210,
      "backgroundColor": "#422006",
      "strokeColor": "#fde047",
      "strokeWidth": 2
    },
    {
      "id": "note_delivery",
      "type": "rectangle",
      "label": "📦 STICKY NOTE: Store-and-Forward & Receipts\n• If recipient is offline, message buffers in Cassandra\n• Apple APNs / Google FCM sends wakeup notification\n• ✓ (One Check): Message safely reached server\n• ✓✓ (Two Checks): Recipient phone received message\n• Server Deletion: Once delivered, server deletes it!\n• Blue ✓✓: Recipient opened the chat window",
      "x": 1400,
      "y": 345,
      "width": 380,
      "height": 225,
      "backgroundColor": "#431407",
      "strokeColor": "#fb923c",
      "strokeWidth": 2
    },
    {
      "id": "note_media",
      "type": "rectangle",
      "label": "🖼️ STICKY NOTE: Why Media Skips WebSockets\n• 50MB videos would choke real-time chat sockets!\n• 1. Client encrypts media locally with random key\n• 2. Uploads directly to S3 via presigned URL\n• 3. Chat server only transmits 1KB message with\n  thumbnail, download link & decryption key\n• 4. Recipient downloads directly from edge CDN",
      "x": 1400,
      "y": 600,
      "width": 380,
      "height": 210,
      "backgroundColor": "#052e16",
      "strokeColor": "#4ade80",
      "strokeWidth": 2
    }
  ]
